Aim: To implement Association Rule Mining using the Apriori algorithm on a transaction dataset, identify frequent itemsets based on minimum support, and generate association rules evaluated by confidence and lift metrics.
Code:

# Association Rule Mining using Apriori

# Install required libraries:
# pip install mlxtend pandas

import pandas as pd
from mlxtend.preprocessing import TransactionEncoder
from mlxtend.frequent_patterns import apriori, association_rules

# Sample transaction dataset
transactions = [
    ['Milk', 'Bread', 'Butter'],
    ['Bread', 'Butter'],
    ['Milk', 'Bread'],
    ['Milk', 'Bread', 'Butter', 'Eggs'],
    ['Bread', 'Eggs'],
    ['Milk', 'Butter'],
    ['Milk', 'Bread', 'Eggs'],
    ['Bread', 'Butter', 'Eggs'],
    ['Milk', 'Bread', 'Butter'],
    ['Milk', 'Eggs']
]

# Convert transactions into one-hot encoded format
te = TransactionEncoder()
te_array = te.fit(transactions).transform(transactions)

df = pd.DataFrame(te_array, columns=te.columns_)

print("Transaction Dataset:")
print(df)

# Find frequent itemsets
frequent_itemsets = apriori(
    df,
    min_support=0.3,
    use_colnames=True
)

print("\nFrequent Itemsets:")
print(frequent_itemsets)

# Generate association rules
rules = association_rules(
    frequent_itemsets,
    metric="confidence",
    min_threshold=0.5
)

# Select important columns
rules = rules[
    ['antecedents', 'consequents', 'support', 'confidence', 'lift']
]

print("\nAssociation Rules:")
print(rules)

# Display rules with high confidence
print("\nRules with Confidence >= 0.6:")
high_confidence_rules = rules[rules['confidence'] >= 0.6]
print(high_confidence_rules)

# Interpretation
print("\nInterpretation:")
for _, rule in high_confidence_rules.iterrows():
    antecedent = ', '.join(rule['antecedents'])
    consequent = ', '.join(rule['consequents'])

    print(
        f"If a customer buys [{antecedent}], "
        f"they are likely to buy [{consequent}]. "
        f"Support = {rule['support']:.2f}, "
        f"Confidence = {rule['confidence']:.2f}, "
        f"Lift = {rule['lift']:.2f}"
    )
