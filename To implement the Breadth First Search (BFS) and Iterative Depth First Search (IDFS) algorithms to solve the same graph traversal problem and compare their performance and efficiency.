graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F', 'G'],
    'D': [],
    'E': [],
    'F': [],
    'G': []
}

def iterative_dfs(graph, start, goal):
    visited = set()
    stack = [start]

    while stack:
        node = stack.pop()

        if node not in visited:
            print(node, end=" ")

            visited.add(node)

            if node == goal:
                print("\nGoal Found!")
                return

            # Reverse order to maintain left-to-right traversal
            for neighbour in reversed(graph[node]):
                if neighbour not in visited:
                    stack.append(neighbour)

iterative_dfs(graph, 'A', 'G')
