A)	Search algorithm
Aim : To implement the A Search Algorithm* to find the shortest path between a source node and a goal node.
Code :

import heapq

# Graph with edge costs
graph = {
    'A': [('B', 1), ('C', 4)],
    'B': [('D', 2), ('E', 5)],
    'C': [('F', 1), ('G', 3)],
    'D': [],
    'E': [],
    'F': [('G', 2)],
    'G': []
}

# Heuristic values
heuristic = {
    'A': 5,
    'B': 4,
    'C': 2,
    'D': 6,
    'E': 3,
    'F': 1,
    'G': 0
}

def astar(start, goal):

    priority_queue = []

    heapq.heappush(priority_queue,
                   (heuristic[start], 0, start, [start]))

    visited = set()

    while priority_queue:

        f, g, current, path = heapq.heappop(priority_queue)

        if current == goal:
            print("Shortest Path:", path)
            print("Total Cost:", g)
            return

        if current in visited:
            continue

        visited.add(current)

        for neighbour, cost in graph[current]:

            if neighbour not in visited:

                new_g = g + cost
                new_f = new_g + heuristic[neighbour]

                heapq.heappush(priority_queue,
                               (new_f,
                                new_g,
                                neighbour,
                                path + [neighbour]))

astar('A', 'G')












B)	Recursive Best-First Search
Aim : To implement Recursive Best First Search for finding the shortest path.
Code :

graph = {
    'A': [('B', 1), ('C', 4)],
    'B': [('D', 2), ('E', 5)],
    'C': [('F', 1), ('G', 3)],
    'D': [],
    'E': [],
    'F': [('G', 2)],
    'G': []
}

heuristic = {
    'A': 5,
    'B': 4,
    'C': 2,
    'D': 6,
    'E': 3,
    'F': 1,
    'G': 0
}

def rbfs(node, goal, cost, path, visited):

    if node == goal:
        return path, cost

    visited.add(node)

    best_path = None
    best_cost = float('inf')

    for neighbour, edge_cost in graph[node]:

        if neighbour not in visited:

            result = rbfs(
                neighbour,
                goal,
                cost + edge_cost,
                path + [neighbour],
                visited.copy()
            )

            if result:

                p, c = result

                if c < best_cost:

                    best_cost = c
                    best_path = p

    if best_path:
        return best_path, best_cost

    return None

result = rbfs('A', 'G', 0, ['A'], set())

print("Shortest Path:", result[0])
print("Total Cost:", result[1])

